<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_card_root"
    android:layout_width="match_parent"
    android:layout_height="108dp"
    android:minHeight="108dp"
    android:background="@android:color/transparent"
    android:paddingStart="6dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/notification_card_action_surface"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:background="@drawable/notification_card_action_surface"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <ImageView
                android:id="@+id/notification_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:scaleType="centerInside" />

            <LinearLayout
                android:id="@+id/notification_actions"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">

                <Button
                    android:id="@+id/notification_dismiss_all"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/notification_card_button"
                    android:includeFontPadding="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="全部关闭"
                    android:textColor="#FFFFFFFF"
                    android:textSize="8sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/notification_process"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/notification_card_button"
                    android:includeFontPadding="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="处理"
                    android:textColor="#FFFFFFFF"
                    android:textSize="9sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/notification_allow"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/notification_card_button"
                    android:includeFontPadding="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="允许"
                    android:textColor="#FFFFFFFF"
                    android:textSize="9sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/notification_deny"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/notification_card_button"
                    android:includeFontPadding="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="拒绝"
                    android:textColor="#FFFFFFFF"
                    android:textSize="9sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/notification_dismiss"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/notification_card_button"
                    android:includeFontPadding="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="关闭"
                    android:textColor="#FFFFFFFF"
                    android:textSize="9sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/notification_stop"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/notification_card_button"
                    android:includeFontPadding="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="停止任务"
                    android:textColor="#FFFFFFFF"
                    android:textSize="8sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notification_card_surface"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/notification_card_surface"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/notification_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                 android:layout_weight="1"
                 android:gravity="center_vertical"
                 android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="4"
                android:textColor="#1B2A3C"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/notification_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/notification_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#536276"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/notification_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#536276"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/notification_token"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#536276"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
