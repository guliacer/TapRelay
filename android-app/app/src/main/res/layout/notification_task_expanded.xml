<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/notification_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="0dp"
        android:gravity="center_vertical"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="4"
        android:textSize="15sp"
        android:textColor="#FFFFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notification_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:id="@+id/notification_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:id="@+id/notification_token"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp"
            android:textColor="#FFFFFFFF"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notification_expanded_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notification_expanded_action_spacer_start"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="0.5"
            android:includeFontPadding="false"
            android:text=""
            android:visibility="gone" />

        <Button
            android:id="@+id/notification_expanded_continue"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/notification_card_button"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="继续"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/notification_expanded_process"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/notification_card_button"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="处理"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/notification_expanded_allow"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/notification_card_button"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="允许"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/notification_expanded_deny"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/notification_card_button"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="拒绝"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/notification_expanded_dismiss_all"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/notification_card_button"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="全部关闭"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/notification_expanded_stop"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/notification_card_button"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="停止任务"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/notification_expanded_dismiss"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/notification_card_button"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="关闭"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/notification_expanded_action_spacer_end"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="0.5"
            android:includeFontPadding="false"
            android:text=""
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
