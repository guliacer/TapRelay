<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TapRelay</AssemblyName>
    <ApplicationIcon>TapRelay.ico</ApplicationIcon>
    <RootNamespace>TapRelay</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>8.0</LangVersion>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <TrimUnusedLiterals>true</TrimUnusedLiterals>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Pin UIAutomation to the Windows Desktop reference pack. Without an explicit
         hint the SDK may resolve the reference from stale publish.* folders under
         the project directory, which adds duplicate satellite assemblies to a
         .NET 3.1 single-file bundle. -->
    <Reference Include="UIAutomationClient">
      <HintPath>$(MSBuildToolsPath)\..\..\packs\Microsoft.WindowsDesktop.App.Ref\3.1.0\ref\netcoreapp3.1\UIAutomationClient.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UIAutomationTypes">
      <HintPath>$(MSBuildToolsPath)\..\..\packs\Microsoft.WindowsDesktop.App.Ref\3.1.0\ref\netcoreapp3.1\UIAutomationTypes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="3.1.32" />
    <PackageReference Include="System.Management" Version="4.7.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\*.png" />
    <None Update="Assets\ComfyUIConsole\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\ComfyUIConsole\**\*" />
  </ItemGroup>

</Project>
